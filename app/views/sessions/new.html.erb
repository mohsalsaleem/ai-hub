<% content_for :title, "Sign in · AI Hub" %><div class="auth-card"><div class="auth-brand"><span class="brand-mark">A</span> AI Hub</div><span class="overline">Model inference control plane</span><h1>Welcome back</h1><p>Sign in to manage your applications and hosting.</p><%= form_with url: session_path, class: "stack-form" do |form| %><label>Email<%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %></label><label>Password<%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %></label><%= form.submit "Sign in", class: "button" %><% end %><p class="auth-foot">New to AI Hub? <%= link_to "Create an account", new_registration_path %></p></div>
