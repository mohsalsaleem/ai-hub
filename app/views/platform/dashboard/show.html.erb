<% content_for :title, "Platform operations · AI Hub" %>
<%= render "shared/page_header", title: "Platform operations", description: "Review shared capacity without exposing tenant prompts or model responses" %>

<section class="metric-grid">
  <article class="metric-card"><span>Organizations</span><strong><%= number_with_delimiter(@organizations.size) %></strong><small>Isolated tenants</small></article>
  <article class="metric-card"><span>Pending review</span><strong><%= @shared_pools.count { |pool| pool.operator_status == "pending_review" } %></strong><small>Shared pools awaiting action</small></article>
  <article class="metric-card"><span>Approved pools</span><strong><%= @shared_pools.count(&:shared_access_enabled?) %></strong><small>Available by consumer grant</small></article>
  <article class="metric-card"><span>Shared capacity</span><strong><%= @shared_workers.count(&:active?) %></strong><small><%= @shared_workers.count(&:online?) %> workers online</small></article>
</section>

<%= render "shared/usage_summary", summary: @shared_usage_summary, label: "Shared usage · 30 days", description: "Cross-organization model work, without prompts or responses" %>

<section class="panel platform-section"><div class="section-head"><div><span class="overline">Ledger control</span><h2>Credit reconciliation</h2></div><%= status_badge(@ledger_reconciliation.balanced ? "balanced" : "attention") %></div><div class="platform-list"><div><span><strong><%= number_with_delimiter(@platform_credits) %> platform credits</strong><small>Internal accounting units</small></span><span><small><%= @ledger_reconciliation.execution_count %> billable executions</small><small><%= @ledger_reconciliation.entry_count %> execution entries</small></span></div></div></section>

<section class="panel platform-section">
  <div class="section-head"><div><span class="overline">Trust boundary</span><h2>Shared pools</h2></div><span class="secondary"><%= pluralize(@shared_pools.size, "pool") %></span></div>
  <div class="table-wrap"><table><thead><tr><th>Pool</th><th>Provider</th><th>Status</th><th>Capacity</th><th>Consumers</th><th>Action</th></tr></thead><tbody>
    <% @shared_pools.each do |pool| %>
      <tr id="pool-<%= pool.id %>">
        <td><strong><%= pool.name %></strong><br><span class="secondary mono"><%= pool.slug %></span></td>
        <td><%= pool.organization.name %></td>
        <td><%= status_badge(pool.operator_status) %></td>
        <td><%= pool.workers.count %> workers<br><span class="secondary"><%= pool.workers.count(&:online?) %> online</span></td>
        <td><%= pool.worker_pool_access_grants.count %> grants</td>
        <td>
          <div class="table-actions">
            <% if pool.operator_status.in?(%w[pending_review suspended]) %>
              <%= button_to "Approve", approve_platform_worker_pool_path(pool), method: :patch, class: "text-button" %>
            <% elsif pool.operator_status == "approved" %>
              <%= button_to "Suspend", suspend_platform_worker_pool_path(pool), method: :patch, class: "text-button" %>
            <% end %>
            <% unless pool.operator_status == "revoked" %>
              <%= button_to "Revoke", revoke_platform_worker_pool_path(pool), method: :patch, class: "text-button danger", data: { turbo_confirm: "Permanently revoke this shared pool? Consumer grants and future routing selections will be removed." } %>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
    <% if @shared_pools.empty? %><tr><td colspan="6" class="empty-state">No provider has submitted shared capacity.</td></tr><% end %>
  </tbody></table></div>
</section>

<div class="platform-grid">
  <section class="panel platform-section">
    <div class="section-head"><div><span class="overline">Metadata only</span><h2>Recent shared runs</h2></div></div>
    <div class="platform-list">
      <% @recent_shared_runs.each do |job| %>
        <div>
          <span><strong class="mono"><%= job.public_id %></strong><small><%= job.hub_application.organization.name %> via <%= job.worker_pool.name %></small></span>
          <% execution = job.job_executions.select(&:finalized?).max_by(&:attempt_number) %>
          <span><%= status_badge(job.status == "leased" ? "running" : job.status) %>
            <small><%= execution&.total_tokens ? "#{number_with_delimiter(execution.total_tokens)} tokens · " : "" %><%= time_ago_in_words(job.created_at) %> ago</small>
          </span>
        </div>
      <% end %>
      <% if @recent_shared_runs.empty? %><p class="empty-state">No cross-organization runs yet.</p><% end %>
    </div>
  </section>

  <section class="panel platform-section">
    <div class="section-head"><div><span class="overline">Tenancy</span><h2>Organizations</h2></div></div>
    <div class="platform-list">
      <% @organizations.each do |organization| %>
        <div id="organization-<%= organization.id %>">
          <span><strong><%= organization.name %></strong><small class="mono"><%= organization.slug %></small></span>
          <span><strong><%= number_with_delimiter(organization.credit_balance) %> credits</strong><button class="text-button" type="button" onclick="document.getElementById('credit-adjustment-<%= organization.id %>').showModal()">Adjust</button></span>
        </div>
        <dialog id="credit-adjustment-<%= organization.id %>" class="dialog"><form method="dialog"><button class="dialog-close" aria-label="Close">×</button></form><h2>Adjust <%= organization.name %></h2><p>Post an immutable positive or negative whole-credit adjustment. Existing entries will not be changed.</p><%= form_with url: platform_organization_credit_adjustment_path(organization), class: "stack-form" do |form| %><label>Amount<%= form.number_field :amount, required: true, step: 1, placeholder: "1000 or -1000" %></label><label>Reason<%= form.text_field :reason, required: true, maxlength: 500 %></label><%= form.submit "Post adjustment", class: "button" %><% end %></dialog>
      <% end %>
    </div>
  </section>
</div>

<section class="panel platform-section">
  <div class="section-head"><div><span class="overline">Immutable</span><h2>Operator audit history</h2></div></div>
  <div class="table-wrap"><table><thead><tr><th>Action</th><th>Subject</th><th>Operator</th><th>When</th></tr></thead><tbody>
    <% @audit_events.each do |event| %>
      <tr><td><%= event.action.humanize %></td><td><%= event.subject_label %> <span class="secondary">#<%= event.subject_id %></span></td><td><%= event.platform_operator.email_address %></td><td><%= time_ago_in_words(event.created_at) %> ago</td></tr>
    <% end %>
    <% if @audit_events.empty? %><tr><td colspan="4" class="empty-state">No operator actions recorded yet.</td></tr><% end %>
  </tbody></table></div>
</section>
