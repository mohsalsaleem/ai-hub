<% content_for :title, "#{@job.public_id} · AI Hub" %>
<div class="detail-page"><%= link_to "← Back to activity", activity_path, class: "back-link" %><div class="detail-title"><div><h1><%= @job.public_id %></h1><%= status_badge(@job.status == "leased" ? "running" : @job.status) %></div></div>
  <dl class="metadata-grid"><div><dt>Task</dt><dd><%= @job.task_definition.reference %></dd></div><div><dt>Application</dt><dd><%= @job.hub_application.name %></dd></div><div><dt>Pool</dt><dd><%= @job.routing_pool_name || "Automatic" %></dd></div><div><dt>Attempts</dt><dd><%= @job.attempts %> / <%= @job.max_attempts %></dd></div><div><dt>Submitted</dt><dd><%= @job.created_at.to_fs(:long) %></dd></div><div><dt>Duration</dt><dd><%= @job.completed_at ? distance_of_time_in_words(@job.created_at, @job.completed_at) : "Pending" %></dd></div></dl>
  <% if @job.job_executions.any? %>
    <%= render "shared/usage_summary", summary: @usage_summary, label: "Execution usage", description: "Measured separately for every processing attempt" %>
    <section class="panel section-block">
      <div class="section-head"><div><span class="overline">Attempts</span><h2>Usage evidence</h2></div></div>
      <div class="table-wrap"><table><thead><tr><th>Attempt</th><th>Outcome</th><th>Input</th><th>Output</th><th>Total</th><th>Model time</th></tr></thead><tbody>
        <% @job.job_executions.sort_by(&:attempt_number).each do |execution| %>
          <tr>
            <td>#<%= execution.attempt_number %></td>
            <td><%= status_badge(execution.outcome) %></td>
            <td><%= execution.input_tokens ? number_with_delimiter(execution.input_tokens) : "Unavailable" %></td>
            <td><%= execution.output_tokens ? number_with_delimiter(execution.output_tokens) : "Unavailable" %></td>
            <td><%= execution.total_tokens ? number_with_delimiter(execution.total_tokens) : "Unavailable" %></td>
            <td><%= format_duration_ms(execution.model_duration_ms) %></td>
          </tr>
        <% end %>
      </tbody></table></div>
    </section>
  <% end %>
  <section class="section-block"><div class="section-head"><div><span class="overline">Routing</span><h2><%= @routing_diagnosis.code.humanize %></h2></div></div><p class="secondary"><%= @routing_diagnosis.summary %></p></section>
  <section class="code-section"><div class="section-head"><h2>Input</h2></div><pre><code><%= pretty_json(@job.input) %></code></pre></section>
  <% if @job.output %><section class="code-section"><div class="section-head"><h2>Output</h2></div><pre><code><%= pretty_json(@job.output) %></code></pre></section><% end %>
  <% if @job.error %><section class="code-section code-error"><div class="section-head"><h2>Error</h2></div><pre><code><%= pretty_json(@job.error) %></code></pre></section><% end %>
</div>
