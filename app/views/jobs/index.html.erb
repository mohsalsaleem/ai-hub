<% content_for :title, "Activity · AI Hub" %>
<%= render "shared/page_header", title: "Activity", description: "Runs across all applications in #{current_organization.name}" %>
<nav class="filter-tabs" aria-label="Run status filters"><%= link_to "All", activity_path, class: @status.nil? ? "is-active" : nil %><% Job::STATUSES.each do |status| %><%= link_to(status == "leased" ? "Running" : status.humanize, activity_path(status: status), class: @status == status ? "is-active" : nil) %><% end %></nav>
<%= render "table", jobs: @jobs %>
