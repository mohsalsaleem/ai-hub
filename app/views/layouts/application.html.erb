<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "AI Hub" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="AI Hub">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>
  <body>
    <% if content_for?(:public_page) %>
      <%= yield %>
    <% elsif platform_console? %>
      <% if platform_authenticated? %>
      <div class="app-frame platform-frame">
        <aside class="sidebar platform-sidebar">
          <div class="brand"><span>AI Hub</span><small>Platform</small></div>
          <div class="org-block"><span class="overline">Operations</span><strong>Platform console</strong><span>Cross-tenant controls</span></div>
          <nav class="nav-stack" aria-label="Platform navigation">
            <div class="nav-primary">
              <%= nav_link "Operations", platform_root_path, section: "dashboard" %>
            </div>
            <div class="nav-secondary">
              <%= nav_link "Tenant console", dashboard_path %>
            </div>
          </nav>
          <div class="account-block">
            <span class="avatar"><%= current_platform_operator.email_address.first.upcase %></span>
            <div><strong><%= current_platform_operator.email_address.split("@").first %></strong><span>Platform operator</span></div>
            <%= button_to "Sign out", platform_session_path, method: :delete, class: "text-button" %>
          </div>
        </aside>
        <main class="main-panel"><%= render "shared/flash" %><%= yield %></main>
      </div>
      <% else %>
        <main class="auth-shell"><%= render "shared/flash" %><%= yield %></main>
      <% end %>
    <% elsif authenticated? && current_organization %>
      <div class="app-frame">
        <aside class="sidebar">
          <div class="brand"><span>AI Hub</span></div>
          <div class="org-block"><span class="overline">Organization</span><strong><%= current_organization.name %></strong><span><%= owner? ? "Owner" : "Member" %></span></div>
          <nav class="nav-stack" aria-label="Main navigation">
            <div class="nav-primary">
              <%= nav_link "Overview", dashboard_path %>
              <%= nav_link "Applications", applications_path, section: [ "hub_applications", "task_definitions" ] %>
              <%= nav_link "Activity", activity_path, section: "jobs" %>
              <% if owner? %><%= nav_link "Hosting", hosting_path, section: "workers" %><% end %>
            </div>
            <div class="nav-secondary">
              <%= nav_link "Documentation", docs_path, section: "docs" %>
              <%= nav_link "Settings", settings_path, section: "organizations" %>
            </div>
          </nav>
          <div class="account-block">
            <span class="avatar"><%= current_user.email_address.first.upcase %></span>
            <div><strong><%= current_user.email_address.split("@").first %></strong><span><%= current_user.email_address %></span></div>
            <%= button_to "Sign out", session_path, method: :delete, class: "text-button" %>
          </div>
        </aside>
        <main class="main-panel"><%= render "shared/flash" %><%= yield %></main>
      </div>
    <% else %>
      <main class="auth-shell"><%= render "shared/flash" %><%= yield %></main>
    <% end %>
  </body>
</html>
