<% content_for :title, "#{@application.name} · AI Hub" %>
<%= render "header", application: @application %>
<%= render "token_reveal" %>

<div class="metric-grid application-metrics">
  <%= link_to task_definitions_application_path(@application), class: "metric-card metric-link" do %>
    <span>Task definitions</span>
    <strong><%= @application.task_definitions.count %></strong>
    <small>Published for this application</small>
  <% end %>
  <%= link_to jobs_application_path(@application), class: "metric-card metric-link" do %>
    <span>Runs</span>
    <strong><%= @application.jobs.count %></strong>
    <small>Model requests from this application</small>
  <% end %>
  <%= link_to settings_application_path(@application), class: "metric-card metric-link" do %>
    <span>Routing</span>
    <strong class="metric-text"><%= @application.worker_pool&.name || "Automatic" %></strong>
    <small>Review pool selection and access</small>
  <% end %>
</div>

<section class="section-block">
  <div class="section-head"><h2>Recent runs</h2><%= link_to "View all", jobs_application_path(@application), class: "quiet-link" %></div>
  <%= render "jobs/table", jobs: @recent_jobs %>
</section>
