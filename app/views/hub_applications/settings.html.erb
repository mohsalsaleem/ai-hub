<% content_for :title, "Settings · #{@application.name} · AI Hub" %>
<%= render "header", application: @application %>
<%= render "token_reveal" %>

<section class="section-block section-block-first panel routing-policy">
  <div class="section-head"><div><span class="overline">Application settings</span><h2>Routing and access</h2></div><span class="chip"><%= worker_trust_label(@application.minimum_worker_trust) %></span></div>
  <p class="secondary">Runs use <%= @application.worker_pool ? @application.worker_pool.name : "automatic private routing" %> when available capacity meets this trust level. Shared pools expose a service boundary, not provider or worker identity.</p>
  <% if owner? %>
    <%= form_with model: @application, url: application_path(@application), class: "routing-form" do |form| %>
      <label>Minimum provider trust<%= form.select :minimum_worker_trust, options_for_select(worker_trust_options, @application.minimum_worker_trust) %></label>
      <label>Worker pool<%= form.collection_select :worker_pool_id, @worker_pools, :id, :name, { include_blank: "Automatic" } %></label>
      <%= form.submit "Save policy", class: "button button-small" %>
    <% end %>
  <% end %>
</section>

<section class="section-block panel routing-policy">
  <div class="section-head"><div><span class="overline">Credentials</span><h2>API access</h2></div><%= status_badge(@application.active? ? "active" : "revoked") %></div>
  <p class="secondary">The current token begins with <span class="mono"><%= @application.token_hint || "an existing value" %></span>. Plaintext tokens are shown only when issued.</p>
  <% if owner? && @application.active? %>
    <div class="danger-zone">
      <div><strong>Application access</strong><span>Rotate the API token or revoke this application.</span></div>
      <div class="action-row"><%= button_to "Rotate token", rotate_token_application_path(@application), method: :post, class: "button button-secondary", data: { turbo_confirm: "Rotate this token? The current token will stop working immediately." } %><%= button_to "Revoke application", revoke_application_path(@application), method: :patch, class: "button button-danger", data: { turbo_confirm: "Revoke this application?" } %></div>
    </div>
  <% end %>
</section>
