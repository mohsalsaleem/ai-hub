<% content_for :title, "Task definitions · #{@application.name} · AI Hub" %>
<%= render "header", application: @application %>

<section class="section-block section-block-first">
  <div class="section-head">
    <div><span class="overline">Application resources</span><h2>Task definitions</h2></div>
  </div>
  <% if owner? %>
    <div class="definition-choice-grid">
      <article class="definition-choice">
        <span class="overline">Native job API</span>
        <h3>Structured generation</h3>
        <p><%= executor_description("structured_generation") %></p>
        <dl><div><dt>Executor</dt><dd><code>structured_generation</code></dd></div><div><dt>Integrate with</dt><dd><code>/api/v1/jobs</code></dd></div></dl>
        <%= link_to "Create structured generation task", new_application_task_definition_path(@application), class: "button" %>
      </article>
      <article class="definition-choice">
        <span class="overline">OpenAI-compatible API</span>
        <h3>Chat completion</h3>
        <p><%= executor_description("chat_completion") %></p>
        <dl><div><dt>Executor</dt><dd><code>chat_completion</code></dd></div><div><dt>Integrate with</dt><dd><code>/v1/responses</code> or <code>/v1/chat/completions</code></dd></div></dl>
        <%= link_to "Create chat completion model", new_application_task_definition_path(@application, executor: "chat_completion"), class: "button button-secondary" %>
      </article>
    </div>
  <% end %>
  <div class="table-wrap"><table><thead><tr><th>Reference</th><th>Executor and integration</th><th>Status</th><th>Digest</th><th>Published</th></tr></thead><tbody><% @definitions.each do |definition| %><tr><td><%= link_to definition.reference, task_definition_path(definition), class: "mono-link" %></td><td><div class="executor-cell"><strong><%= executor_label(definition.executor) %></strong><code><%= definition.executor %></code><small><%= executor_endpoint(definition.executor) %></small></div></td><td><%= status_badge(definition.active? ? "active" : "archived") %></td><td class="mono"><%= definition.digest.first(12) %></td><td><%= time_ago_in_words(definition.created_at) %> ago</td></tr><% end %><% if @definitions.empty? %><tr><td colspan="5" class="empty-state">No task definitions published.</td></tr><% end %></tbody></table></div>
</section>
