<% content_for :title, "Settings · AI Hub" %><div class="settings-heading"><%= render "shared/page_header", title: "Settings", description: "Organization identity, membership and access" %></div>
<nav class="section-tabs" aria-label="Settings sections"><%= link_to "Organization", settings_path, class: "is-active" %></nav>
<div class="settings-grid"><section class="panel"><span class="overline">Organization</span><h2><%= current_organization.name %></h2><dl class="settings-list"><div><dt>Organization ID</dt><dd class="mono">org_<%= current_organization.id.to_s(36).rjust(8, "0") %></dd></div><div><dt>Members</dt><dd><%= @memberships.count %></dd></div><div><dt>Created</dt><dd><%= current_organization.created_at.strftime("%B %Y") %></dd></div></dl><% if owner? %><%= form_with model: current_organization, url: organization_path, class: "inline-form" do |form| %><%= form.text_field :name, required: true %><%= form.submit "Save", class: "button button-secondary" %><% end %><% end %></section><section class="panel"><span class="overline">Isolation</span><h2>Tenant boundary</h2><p class="body-copy">Every application, task definition, run, token and worker belongs exclusively to this organization. Workers can only claim runs created inside this boundary.</p></section></div>
<section class="panel section-block"><div class="section-head"><div><span class="overline">Internal credits</span><h2>Balance</h2></div><strong><%= number_with_delimiter(@credit_balance) %></strong></div><p class="body-copy">Internal accounting units only. Payments and cash conversion are not enabled.</p><% if @recent_credit_entries.any? %><div class="table-wrap"><table><thead><tr><th>When</th><th>Type</th><th>Amount</th><th>Reason</th></tr></thead><tbody><% @recent_credit_entries.each do |entry| %><tr><td><%= time_ago_in_words(entry.created_at) %> ago</td><td><%= entry.entry_type.humanize %></td><td><%= entry.amount.positive? ? "+#{number_with_delimiter(entry.amount)}" : number_with_delimiter(entry.amount) %></td><td><%= entry.reason || "Shared execution" %></td></tr><% end %></tbody></table></div><% end %></section>
<section class="section-block"><div class="section-head"><h2>Members</h2><span class="secondary">Invitations coming next</span></div><div class="table-wrap"><table><thead><tr><th>Email</th><th>Role</th><th>Joined</th></tr></thead><tbody><% @memberships.each do |membership| %><tr><td><%= membership.user.email_address %></td><td><%= status_badge(membership.role) %></td><td><%= membership.created_at.strftime("%b %d, %Y") %></td></tr><% end %></tbody></table></div></section>
