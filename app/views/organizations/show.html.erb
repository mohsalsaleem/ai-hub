<% content_for :title, "Organization settings · AI Hub" %><%= render "shared/page_header", title: "Organization settings", description: "Identity, access and tenant boundary for #{current_organization.name}" %>
<div class="settings-grid"><section class="panel"><span class="overline">Organization</span><h2><%= current_organization.name %></h2><dl class="settings-list"><div><dt>Organization ID</dt><dd class="mono">org_<%= current_organization.id.to_s(36).rjust(8, "0") %></dd></div><div><dt>Members</dt><dd><%= @memberships.count %></dd></div><div><dt>Created</dt><dd><%= current_organization.created_at.strftime("%B %Y") %></dd></div></dl><% if owner? %><%= form_with model: current_organization, url: organization_path, class: "inline-form" do |form| %><%= form.text_field :name, required: true %><%= form.submit "Save", class: "button button-secondary" %><% end %><% end %></section><section class="panel"><span class="overline">Isolation</span><h2>Tenant boundary</h2><p class="body-copy">Every application, task definition, job, token and worker belongs exclusively to this organization. Workers can only claim jobs created inside this boundary.</p></section></div>
<section class="section-block"><div class="section-head"><h2>Members</h2><span class="secondary">Invitations coming next</span></div><div class="table-wrap"><table><thead><tr><th>Email</th><th>Role</th><th>Joined</th></tr></thead><tbody><% @memberships.each do |membership| %><tr><td><%= membership.user.email_address %></td><td><%= status_badge(membership.role) %></td><td><%= membership.created_at.strftime("%b %d, %Y") %></td></tr><% end %></tbody></table></div></section>
