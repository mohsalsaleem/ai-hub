<% content_for :title, "Create organization · AI Hub" %><div class="auth-card"><div class="auth-brand"><span class="brand-mark">A</span> AI Hub</div><h1>Create your organization</h1><p>This is the private boundary for your applications, tasks and workers.</p><%= form_with model: @organization, url: organization_path, class: "stack-form" do |form| %><%= render "shared/errors", record: @organization %><label>Organization name<%= form.text_field :name, required: true, autofocus: true %></label><%= form.submit "Create organization", class: "button" %><% end %></div>
