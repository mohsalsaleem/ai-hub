<% content_for :title, "#{@definition.reference} · AI Hub" %>
<div class="detail-page"><%= link_to "← Task definitions", task_definitions_path, class: "back-link" %><div class="detail-title"><div><h1><%= @definition.reference %></h1><p><%= @definition.hub_application.name %> · <%= @definition.executor.humanize %></p></div><span class="badge badge-good">Published</span></div><dl class="metadata-grid"><div><dt>Digest</dt><dd class="mono"><%= @definition.digest %></dd></div><div><dt>Published</dt><dd><%= @definition.created_at.to_fs(:long) %></dd></div></dl><section class="code-section prose-section"><h2>Instructions</h2><p><%= @definition.instructions %></p></section><div class="schema-grid"><section class="code-section"><h2>Input schema</h2><pre><code><%= pretty_json(@definition.input_schema) %></code></pre></section><section class="code-section"><h2>Output schema</h2><pre><code><%= pretty_json(@definition.output_schema) %></code></pre></section></div></div>
