<% content_for :title, "#{@definition.reference} · AI Hub" %>
<div class="detail-page">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><%= link_to "Applications", applications_path %><span>/</span><%= link_to @definition.hub_application.name, task_definitions_application_path(@definition.hub_application) %><span>/</span><span>Tasks & models</span></nav>
  <div class="detail-title">
    <div><h1><%= @definition.reference %></h1><p><%= executor_label(@definition.executor) %></p></div>
    <div class="card-actions"><%= status_badge(@definition.active? ? "active" : "archived") %><% if owner? %><%= link_to "Publish new version", new_application_task_definition_path(@definition.hub_application, from: @definition.id), class: "button" %><% end %></div>
  </div>
  <dl class="metadata-grid"><div><dt>Executor</dt><dd><strong><%= executor_label(@definition.executor) %></strong><br><code><%= @definition.executor %></code></dd></div><div><dt>Integration endpoint</dt><dd><code><%= executor_endpoint(@definition.executor) %></code></dd></div><div><dt>Digest</dt><dd class="mono"><%= @definition.digest %></dd></div><div><dt>Published</dt><dd><%= @definition.created_at.to_fs(:long) %></dd></div></dl>
  <p class="definition-explanation"><%= executor_description(@definition.executor) %></p>
  <section class="panel section-block"><div class="section-head"><div><span class="overline">Version history</span><h2><%= @definition.key %></h2></div></div><div class="chip-row"><% @versions.each do |version| %><%= link_to "v#{version.version}#{version.active? ? "" : " · archived"}", task_definition_path(version), class: "chip#{version == @definition ? " chip-neutral" : ""}", aria: { current: version == @definition ? "page" : nil } %><% end %></div></section>
  <% unless @definition.active? %><div class="archived-notice" role="status"><strong>Archived definition</strong><span>New runs cannot use this reference. Existing and historical runs remain available.</span></div><% end %>
  <section class="code-section prose-section"><h2>Instructions</h2><p><%= @definition.instructions %></p></section>
  <div class="schema-grid"><section class="code-section"><h2>Input schema</h2><pre><code><%= pretty_json(@definition.input_schema) %></code></pre></section><section class="code-section"><h2>Output schema</h2><pre><code><%= pretty_json(@definition.output_schema) %></code></pre></section></div>
  <% if owner? %><div class="danger-zone"><div><strong><%= @definition.active? ? "Archive this definition" : "Restore this definition" %></strong><span><%= @definition.active? ? "Stop new runs from using this reference. Existing runs are not interrupted." : "Allow new runs to use this reference again." %></span></div><% if @definition.active? %><%= button_to "Archive definition", archive_task_definition_path(@definition), method: :patch, class: "button button-danger", form: { data: { turbo_confirm: "Archive #{@definition.reference}? New runs will no longer be accepted." } } %><% else %><%= button_to "Restore definition", restore_task_definition_path(@definition), method: :patch, class: "button button-secondary" %><% end %></div><% end %>
</div>
