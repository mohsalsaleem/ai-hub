<% content_for :title, "Task definitions · AI Hub" %>
<%= render "shared/page_header", title: "Task definitions", description: "Immutable instructions and typed input/output contracts" %>
<div class="table-wrap"><table><thead><tr><th>Reference</th><th>Application</th><th>Executor</th><th>Digest</th><th>Published</th></tr></thead><tbody><% @definitions.each do |definition| %><tr><td><%= link_to definition.reference, task_definition_path(definition), class: "mono-link" %></td><td><%= definition.hub_application.name %></td><td><%= definition.executor.humanize %></td><td class="mono"><%= definition.digest.first(12) %></td><td><%= time_ago_in_words(definition.created_at) %> ago</td></tr><% end %><% if @definitions.empty? %><tr><td colspan="5" class="empty-state">Create an application, then publish its first task definition.</td></tr><% end %></tbody></table></div>
