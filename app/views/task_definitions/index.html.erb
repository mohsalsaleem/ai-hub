<% content_for :title, "Task definitions · AI Hub" %>
<%= render "shared/page_header", title: "Task definitions", description: "Immutable instructions and typed input/output contracts" %>
<div class="table-wrap"><table><thead><tr><th>Reference</th><th>Application</th><th>Executor and integration</th><th>Status</th><th>Digest</th><th>Published</th></tr></thead><tbody><% @definitions.each do |definition| %><tr><td><%= link_to definition.reference, task_definition_path(definition), class: "mono-link" %></td><td><%= definition.hub_application.name %></td><td><div class="executor-cell"><strong><%= executor_label(definition.executor) %></strong><code><%= definition.executor %></code><small><%= executor_endpoint(definition.executor) %></small></div></td><td><%= status_badge(definition.active? ? "active" : "archived") %></td><td class="mono"><%= definition.digest.first(12) %></td><td><%= time_ago_in_words(definition.created_at) %> ago</td></tr><% end %><% if @definitions.empty? %><tr><td colspan="6" class="empty-state">Create an application, then publish its first task definition.</td></tr><% end %></tbody></table></div>
