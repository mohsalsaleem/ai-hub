<% content_for :title, "Publish task · AI Hub" %>
<div class="form-page form-page-wide"><%= link_to "← #{@application.name}", application_path(@application), class: "back-link" %><h1><%= @definition.executor == "chat_completion" ? "Publish an OpenAI model profile" : "Publish a task definition" %></h1><p>Published versions are immutable. Create a new version when instructions or schemas change.</p>
  <%= form_with model: [@application, @definition], class: "stack-form" do |form| %><%= render "shared/errors", record: @definition %><div class="form-grid"><label>Task key<%= form.text_field :key, required: true, placeholder: "sums.extract-message" %></label><label>Version<%= form.number_field :version, required: true, min: 1 %></label></div><%= form.hidden_field :executor %><label>Instructions<%= form.text_area :instructions, required: true, rows: 8, placeholder: "Describe exactly what the model should do and must not invent." %></label><div class="schema-grid"><label>Input JSON schema<%= form.text_area :input_schema, value: pretty_json(@definition.input_schema), required: true, rows: 16, class: "code-input" %></label><label>Output JSON schema<%= form.text_area :output_schema, value: pretty_json(@definition.output_schema), required: true, rows: 16, class: "code-input" %></label></div><%= form.submit "Publish immutable version", class: "button" %><% end %>
</div>
