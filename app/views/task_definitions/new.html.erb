<% content_for :title, "Publish task · AI Hub" %>
<div class="form-page form-page-wide"><%= link_to "← #{@application.name}", task_definitions_application_path(@application), class: "back-link" %><h1>Publish <%= executor_label(@definition.executor).downcase %></h1><p><%= executor_description(@definition.executor) %> Published versions are immutable.</p>
  <div class="executor-summary" aria-label="Selected executor"><div><span>Executor</span><code><%= @definition.executor %></code></div><div><span>Integration endpoint</span><code><%= executor_endpoint(@definition.executor) %></code></div></div>
  <%= form_with model: @definition, url: application_task_definitions_path(@application), class: "stack-form" do |form| %><%= render "shared/errors", record: @definition %><div class="form-grid"><label><%= @definition.executor == "chat_completion" ? "Model key" : "Task key" %><%= form.text_field :key, required: true, placeholder: @definition.executor == "chat_completion" ? "travel.rank" : "document.summarize" %></label><label>Version<%= form.number_field :version, required: true, min: 1 %></label></div><%= form.hidden_field :executor %><label><%= @definition.executor == "chat_completion" ? "Model instructions" : "Task instructions" %><%= form.text_area :instructions, required: true, rows: 8, placeholder: "Describe exactly what the model should do and must not invent." %></label><div class="schema-grid"><label>Input JSON schema<%= form.text_area :input_schema, value: pretty_json(@definition.input_schema), required: true, rows: 16, class: "code-input" %></label><label>Output JSON schema<%= form.text_area :output_schema, value: pretty_json(@definition.output_schema), required: true, rows: 16, class: "code-input" %></label></div><%= form.submit "Publish #{executor_label(@definition.executor).downcase}", class: "button" %><% end %>
</div>
