<% content_for :title, "Overview · AI Hub" %>
<%= render "shared/page_header", title: "Overview", description: "Jobs, workers and applications across #{current_organization.name} at a glance" %>
<section class="metric-grid">
  <article class="metric-card"><span>Jobs · 24h</span><strong><%= number_with_delimiter(@recent_count) %></strong><small><%= @success_rate ? "#{@success_rate.round(1)}% success rate" : "No jobs in this period" %></small></article>
  <article class="metric-card"><span>Active workers</span><strong><%= @workers.count(&:online?) %> / <%= @workers.size %></strong><small><%= @workers.count { |worker| !worker.online? } %> offline</small></article>
  <article class="metric-card"><span>Applications</span><strong><%= @applications.count %></strong><small><%= @applications.where(active: true).count %> active</small></article>
  <article class="metric-card"><span>Task definitions</span><strong><%= @definitions.count %></strong><small>Immutable published versions</small></article>
</section>
<div class="overview-grid">
  <section class="panel"><div class="section-head"><div><span class="overline">Live</span><h2>Recent jobs</h2></div><%= link_to "View all", jobs_path, class: "quiet-link" %></div><%= render "jobs/table", jobs: @jobs %></section>
  <section class="panel"><div class="section-head"><div><span class="overline">Fleet</span><h2>Worker health</h2></div><%= link_to "Manage", workers_path, class: "quiet-link" %></div>
    <div class="health-list"><% @workers.each do |worker| %><%= link_to workers_path(anchor: "worker-#{worker.id}"), class: "health-row" do %><span class="status-dot <%= worker.online? ? 'is-online' : 'is-offline' %>"></span><strong><%= worker.name %></strong><%= status_badge(worker.online? ? "online" : "offline") %><% end %><% end %><% if @workers.empty? %><p class="empty-state">No workers connected yet.</p><% end %></div>
  </section>
</div>
