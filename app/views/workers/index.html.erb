<% content_for :title, "Workers · AI Hub" %>
<% action = owner? ? capture do %><button class="button" type="button" onclick="document.getElementById('worker-form').showModal()">Issue worker token</button><% end : nil %>
<%= render "shared/page_header", title: "Workers", description: "Connected model workers, capabilities and health", action: action %>
<% if flash[:issued_token] %><section class="token-reveal" id="issued-token"><span class="overline">Shown once</span><h2>Copy your worker token</h2><div class="token-value"><code><%= flash[:issued_token] %></code></div><p>Configure it as <span class="mono">AI_HUB_WORKER_TOKEN</span> on the worker host.</p></section><% end %>
<div class="worker-grid"><% @workers.each do |worker| %><article class="worker-card" id="worker-<%= worker.id %>"><div class="worker-head"><div><span class="status-dot <%= worker.online? ? 'is-online' : 'is-offline' %>"></span><h2><%= worker.name %></h2></div><%= status_badge(worker.online? ? "online" : "offline") %></div><div class="worker-meta"><span><%= worker.version || "Version unknown" %></span><span><%= number_with_delimiter(worker.jobs.count) %> jobs</span></div><div class="chip-row"><% worker.capabilities.each do |capability| %><span class="chip"><%= capability %></span><% end %><% if worker.capabilities.empty? %><span class="secondary">Capabilities reported on first connection</span><% end %></div><p class="last-seen">Last activity: <%= worker.last_seen_at ? time_ago_in_words(worker.last_seen_at) + " ago" : "never" %></p><% if owner? && worker.active? %><div class="card-actions"><%= button_to "Rotate token", rotate_token_worker_path(worker), method: :post, class: "text-button", data: { turbo_confirm: "Rotate this worker token?" } %><%= button_to "Revoke", worker_path(worker), method: :delete, class: "text-button danger", data: { turbo_confirm: "Revoke this worker?" } %></div><% end %></article><% end %><% if @workers.empty? %><div class="empty-panel"><h2>No workers connected</h2><p>Issue a worker token and configure it beside your model.</p></div><% end %></div>
<dialog id="worker-form" class="dialog"><form method="dialog"><button class="dialog-close" aria-label="Close">×</button></form><h2>Issue worker token</h2><p>Name the machine or runtime that will claim this organization’s jobs.</p><%= form_with model: @worker, url: workers_path, class: "stack-form" do |form| %><label>Worker name<%= form.text_field :name, required: true, autofocus: true, placeholder: "Home model worker" %></label><%= form.submit "Issue token", class: "button" %><% end %></dialog>
