<% content_for :title, "Create account · AI Hub" %><div class="auth-card"><div class="auth-brand"><span class="brand-mark">A</span> AI Hub</div><span class="overline">Start building</span><h1>Create your AI Hub</h1><p>Set up an isolated organization and connect your first application.</p><%= form_with model: @user, url: registration_path, class: "stack-form" do |form| %><%= render "shared/errors", record: @user %><label>Email<%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username" %></label><label>Password<%= form.password_field :password, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password" %><small>At least 8 characters. No confirmation required.</small></label><label>Organization name<%= form.text_field :organization_name, required: true, placeholder: "Acme" %></label><%= form.submit "Create account", class: "button" %><% end %><p class="auth-foot">Already have an account? <%= link_to "Sign in", new_session_path %></p></div>
