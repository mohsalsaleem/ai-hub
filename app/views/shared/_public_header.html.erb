<header class="site-header">
  <%= link_to root_path, class: "site-brand", aria: { label: "AI Hub home" } do %><span class="brand-mark">A</span><span>AI Hub</span><% end %>
  <nav class="site-nav" aria-label="Public navigation">
    <%= link_to "Docs", docs_path %>
    <% if authenticated? %>
      <%= link_to "Dashboard", dashboard_path, class: "button button-small" %>
    <% else %>
      <%= link_to "Sign in", new_session_path %>
      <%= link_to "Get started", new_registration_path, class: "button button-small" %>
    <% end %>
  </nav>
</header>
