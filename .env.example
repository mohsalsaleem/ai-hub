AI_HUB_ADMIN_PASSWORD=replace-with-a-long-random-password
# Application and worker bearer tokens are generated with:
# APP_NAME=Example APP_SLUG=example WORKER_NAME=Home bin/rails hub:bootstrap

# Optional Homebase login; keep off until the dedicated client/key are provisioned.
# Public registration, password login and platform-operator login stay independent.
HOMEBASE_AUTH_MODE=off
PUBLIC_URL=https://aihub.mohsal.dev
OIDC_ISSUER=https://auth.mohsal.dev/realms/homebase
OIDC_CLIENT_ID=aihub
OIDC_CLIENT_SECRET=
HOMEBASE_URL=https://homebase.mohsal.dev
HOMEBASE_APP_KEY=
# Existing SECRET_KEY_BASE must stay stable: it also protects provider tokens.
